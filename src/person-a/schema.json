{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VibeCheck Element Schema",
  "description": "Contract for all extracted and expected element data flowing through VibeCheck pipeline",
  "type": "object",
  "properties": {
    "elements": {
      "type": "array",
      "description": "List of UI elements detected or expected on the page",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stable identifier for this element (e.g., 'submit_button', 'email_input'). Used to match expected vs found elements.",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "description": "Semantic element type, not raw HTML tag",
            "enum": [
              "button",
              "input",
              "textarea",
              "heading",
              "text",
              "image",
              "link",
              "checkbox",
              "radio",
              "select",
              "label",
              "card",
              "container",
              "icon",
              "badge",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "description": "Visible text content inside the element (empty string if no text)",
            "default": ""
          },
          "position": {
            "type": "object",
            "description": "Absolute pixel position and size from boundingClientRect",
            "properties": {
              "x": {
                "type": "number",
                "description": "Distance from left edge of viewport (pixels)"
              },
              "y": {
                "type": "number",
                "description": "Distance from top edge of viewport (pixels)"
              },
              "width": {
                "type": "number",
                "description": "Element width (pixels)",
                "minimum": 0
              },
              "height": {
                "type": "number",
                "description": "Element height (pixels)",
                "minimum": 0
              }
            },
            "required": ["x", "y", "width", "height"]
          },
          "relative_position": {
            "type": "object",
            "description": "Relative spatial relationship to other elements (more robust than absolute coordinates)",
            "properties": {
              "below": {
                "type": "string",
                "description": "ID of the element this one sits below (if applicable)"
              },
              "above": {
                "type": "string",
                "description": "ID of the element this one sits above (if applicable)"
              },
              "left_of": {
                "type": "string",
                "description": "ID of the element this one sits left of (if applicable)"
              },
              "right_of": {
                "type": "string",
                "description": "ID of the element this one sits right of (if applicable)"
              },
              "alignment": {
                "type": "string",
                "description": "Horizontal alignment relative to related element",
                "enum": ["centered", "left-aligned", "right-aligned", "justified"]
              }
            }
          },
          "style": {
            "type": "object",
            "description": "Computed visual style properties (only checked properties, not exhaustive)",
            "properties": {
              "color": {
                "type": "string",
                "description": "Text color in hex format (e.g., '#FFFFFF', '#000000')",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "background_color": {
                "type": "string",
                "description": "Background color in hex format",
                "pattern": "^#[0-9A-Fa-f]{6}$|^transparent$"
              },
              "font_size": {
                "type": "number",
                "description": "Font size in pixels",
                "minimum": 8,
                "maximum": 120
              },
              "font_weight": {
                "type": "string",
                "description": "Font weight descriptor",
                "enum": ["normal", "bold", "lighter", "100", "200", "300", "400", "500", "600", "700", "800", "900"]
              },
              "border_radius": {
                "type": "number",
                "description": "Border radius in pixels (0 for sharp corners)",
                "minimum": 0
              },
              "padding": {
                "type": "string",
                "description": "Padding value (e.g., '8px', '10px 20px')"
              },
              "opacity": {
                "type": "number",
                "description": "Opacity value between 0 and 1",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required": {
            "type": "boolean",
            "description": "If true, element's presence is a hard requirement (missing = broken). If false, element is optional (missing = soft warning).",
            "default": true
          },
          "visibility": {
            "type": "string",
            "description": "Visibility state of the element",
            "enum": ["visible", "hidden", "off-screen"],
            "default": "visible"
          }
        },
        "required": ["id", "type", "position"]
      }
    },
    "layout": {
      "type": "object",
      "description": "High-level layout properties of the whole page or screen",
      "properties": {
        "container_alignment": {
          "type": "string",
          "description": "Overall alignment of the main content container",
          "enum": ["centered", "left-aligned", "right-aligned", "full-width"]
        },
        "total_elements_expected": {
          "type": "number",
          "description": "Rough count of expected elements (sanity check)",
          "minimum": 1
        },
        "viewport_width": {
          "type": "number",
          "description": "Viewport width in pixels (for context)"
        },
        "viewport_height": {
          "type": "number",
          "description": "Viewport height in pixels (for context)"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata about the dataset (source, timestamp, etc.)",
      "properties": {
        "source": {
          "type": "string",
          "description": "Where this data came from: 'extracted' or 'generated'",
          "enum": ["extracted", "generated", "manual"]
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp when this was created"
        },
        "url": {
          "type": "string",
          "description": "URL of the page (for extracted), or user prompt (for generated)"
        }
      }
    }
  },
  "required": ["elements"]
}